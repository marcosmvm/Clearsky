  },
  "reclassified": {
    "#8FA2BD": {
      "status": "reclassified, not retired",
      "history": "The UI Kit retired this as type at any size on the strength of a single measurement — 2.58:1 on white. That measurement is correct and the conclusion was not: the value was simultaneously the system's only on-dark ink. A blanket sweep to --ink-3 regressed 31 passing texts to failing across three files.",
      "nowNamed": "--ink-on-dark",
      "rule": "Light ground: never. Dark ground: correct, and --ink-3 is wrong there.",
      "enforcedBy": "tokens/contrast.mjs, which resolves the ground behind each value and measures it, rather than blocklisting a hex."
    }
  }
